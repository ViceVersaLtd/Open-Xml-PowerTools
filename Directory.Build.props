<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)\rules.ruleset</CodeAnalysisRuleSet>
    <!-- IPackage APIs are experimental in DocumentFormat.OpenXml 3.x but required for low-level part work. -->
    <NoWarn>$(NoWarn);OOXML0001</NoWarn>
  </PropertyGroup>
</Project>
